# Base URL of the SmartCop backend (no trailing slash, no /api/v1)
VITE_API_BASE_URL=http://localhost:8000
# Load the third-party DocuChat widget (off by default)
VITE_ENABLE_DOCUCHAT=false
# Use the backend voice/legal assistant endpoints (planned B2); off = "coming soon"
VITE_ENABLE_VOICE_ASSISTANT=false
# Minutes of inactivity before automatic sign-out
VITE_IDLE_TIMEOUT_MINUTES=20
